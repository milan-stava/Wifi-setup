2920+ CF85              ConvRStr16
2921+ CF85              ;===============================================================
2922+ CF85              ;http://z80-heaven.wikidot.com/math#toc32
2923+ CF85              ;Input:
2924+ CF85              ;     DE points to the base 10 number string in RAM.
2925+ CF85              ;Outputs:
2926+ CF85              ;     HL is the 16-bit value of the number
2927+ CF85              ;     DE points to the byte after the number
2928+ CF85              ;     BC is HL/10
2929+ CF85              ;     z flag reset (nz)
2930+ CF85              ;     c flag reset (nc)
2931+ CF85              ;Destroys:
2932+ CF85              ;     A (actually, add 30h and you get the ending token)
2933+ CF85              ;Size:  23 bytes
2934+ CF85              ;Speed: 104n+42+11c
2935+ CF85              ;       n is the number of digits
2936+ CF85              ;       c is at most n-2
2937+ CF85              ;       at most 595 cycles for any 16-bit decimal value
2938+ CF85              ;===============================================================
2939+ CF85
2940+ CF85 21 00 00          ld hl,0          ;  10 : 210000
2941+ CF88              ConvLoop:             ;
2942+ CF88 1A                ld a,(de)        ;   7 : 1A
2943+ CF89 D6 30             sub 30h          ;   7 : D630
2944+ CF8B FE 0A             cp 10            ;   7 : FE0A
2945+ CF8D D0                ret nc           ;5|11 : D0
2946+ CF8E 13                inc de           ;   6 : 13
2947+ CF8F                                    ;
2948+ CF8F 44                ld b,h           ;   4 : 44
2949+ CF90 4D                ld c,l           ;   4 : 4D
2950+ CF91 29                add hl,hl        ;  11 : 29
2951+ CF92 29                add hl,hl        ;  11 : 29
2952+ CF93 09                add hl,bc        ;  11 : 09
2953+ CF94 29                add hl,hl        ;  11 : 29
2954+ CF95                                    ;
2955+ CF95 85                add a,l          ;   4 : 85
2956+ CF96 6F                ld l,a           ;   4 : 6F
2957+ CF97 30 EF             jr nc,ConvLoop   ;12|23: 30EE
2958+ CF99 24                inc h            ; --- : 24
2959+ CF9A 18 EC             jr ConvLoop      ; --- : 18EB
2960+ CF9C
2961+ CF9C
