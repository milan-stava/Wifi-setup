2921+ CF89              ;===============================================================
2922+ CF89              ;http://z80-heaven.wikidot.com/math#toc32
2923+ CF89              ;Input:
2924+ CF89              ;     DE points to the base 10 number string in RAM.
2925+ CF89              ;Outputs:
2926+ CF89              ;     HL is the 16-bit value of the number
2927+ CF89              ;     DE points to the byte after the number
2928+ CF89              ;     BC is HL/10
2929+ CF89              ;     z flag reset (nz)
2930+ CF89              ;     c flag reset (nc)
2931+ CF89              ;Destroys:
2932+ CF89              ;     A (actually, add 30h and you get the ending token)
2933+ CF89              ;Size:  23 bytes
2934+ CF89              ;Speed: 104n+42+11c
2935+ CF89              ;       n is the number of digits
2936+ CF89              ;       c is at most n-2
2937+ CF89              ;       at most 595 cycles for any 16-bit decimal value
2938+ CF89              ;===============================================================
2939+ CF89
2940+ CF89 21 00 00          ld hl,0          ;  10 : 210000
2941+ CF8C              ConvLoop:             ;
2942+ CF8C 1A                ld a,(de)        ;   7 : 1A
2943+ CF8D D6 30             sub 30h          ;   7 : D630
2944+ CF8F FE 0A             cp 10            ;   7 : FE0A
2945+ CF91 D0                ret nc           ;5|11 : D0
2946+ CF92 13                inc de           ;   6 : 13
2947+ CF93                                    ;
2948+ CF93 44                ld b,h           ;   4 : 44
2949+ CF94 4D                ld c,l           ;   4 : 4D
2950+ CF95 29                add hl,hl        ;  11 : 29
2951+ CF96 29                add hl,hl        ;  11 : 29
2952+ CF97 09                add hl,bc        ;  11 : 09
2953+ CF98 29                add hl,hl        ;  11 : 29
2954+ CF99                                    ;
2955+ CF99 85                add a,l          ;   4 : 85
2956+ CF9A 6F                ld l,a           ;   4 : 6F
2957+ CF9B 30 EF             jr nc,ConvLoop   ;12|23: 30EE
2958+ CF9D 24                inc h            ; --- : 24
2959+ CF9E 18 EC             jr ConvLoop      ; --- : 18EB
