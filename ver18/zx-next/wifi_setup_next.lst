3000+ D05B              ;16)
3001+ D05B              ConvRStr16
3002+ D05B              ;===============================================================
3003+ D05B              ;http://z80-heaven.wikidot.com/math#toc32
3004+ D05B              ;Input:
3005+ D05B              ;     DE points to the base 10 number string in RAM.
3006+ D05B              ;Outputs:
3007+ D05B              ;     HL is the 16-bit value of the number
3008+ D05B              ;     DE points to the byte after the number
3009+ D05B              ;     BC is HL/10
3010+ D05B              ;     z flag reset (nz)
3011+ D05B              ;     c flag reset (nc)
3012+ D05B              ;Destroys:
3013+ D05B              ;     A (actually, add 30h and you get the ending token)
3014+ D05B              ;Size:  23 bytes
3015+ D05B              ;Speed: 104n+42+11c
3016+ D05B              ;       n is the number of digits
3017+ D05B              ;       c is at most n-2
3018+ D05B              ;       at most 595 cycles for any 16-bit decimal value
3019+ D05B              ;===============================================================
3020+ D05B
3021+ D05B 21 00 00          ld hl,0          ;  10 : 210000
3022+ D05E              ConvLoop:             ;
3023+ D05E 1A                ld a,(de)        ;   7 : 1A
3024+ D05F D6 30             sub 30h          ;   7 : D630
3025+ D061 FE 0A             cp 10            ;   7 : FE0A
3026+ D063 D0                ret nc           ;5|11 : D0
3027+ D064 13                inc de           ;   6 : 13
3028+ D065                                    ;
3029+ D065 44                ld b,h           ;   4 : 44
3030+ D066 4D                ld c,l           ;   4 : 4D
3031+ D067 29                add hl,hl        ;  11 : 29
3032+ D068 29                add hl,hl        ;  11 : 29
3033+ D069 09                add hl,bc        ;  11 : 09
3034+ D06A 29                add hl,hl        ;  11 : 29
3035+ D06B                                    ;
3036+ D06B 85                add a,l          ;   4 : 85
3037+ D06C 6F                ld l,a           ;   4 : 6F
3038+ D06D 30 EF             jr nc,ConvLoop   ;12|23: 30EE
3039+ D06F 24                inc h            ; --- : 24
3040+ D070 18 EC             jr ConvLoop      ; --- : 18EB
3041+ D072
